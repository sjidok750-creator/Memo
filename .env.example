# Claude API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 사용할 모델 (기본 claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# 선택: 생각 깊이 low | medium | high | xhigh | max (기본은 API 기본값 high)
# CLAUDE_EFFORT=medium

# 선택: 메모 저장 위치 (기본 ./data)
# MEMO_DATA_DIR=./data

# 개발용: 1 이면 Claude 를 부르지 않고 예시 요약을 돌려준다
# MEMO_MOCK=1
