{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gist-sync",
  "main": "gist-worker.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // Gist 앱 주소 (저장 후 Claude 가 알려주는 링크와 "앱에 연결" 버튼에 쓰인다)
    "APP_URL": "https://sjidok750-creator.github.io/Memo"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gist-memos"
      // 명령어로 배포할 때: npx wrangler d1 create gist-memos → 나온 id 를 "database_id": "..." 로 추가
    }
  ]
}
